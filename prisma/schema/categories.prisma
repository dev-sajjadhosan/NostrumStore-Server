enum CategoryStatus {
  ACTIVE
  RESTRICTED
  INACTIVE
}

model Categories {
  id          String         @id @default(uuid())
  name        String         @unique
  image       String?
  description String?
  status      CategoryStatus @default(ACTIVE)
  medicines   Medicines[]
  slug        String         @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
